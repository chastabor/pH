# The environment a phern-daemon unit reads (EnvironmentFile=). One `KEY=value`
# per line; systemd does no shell expansion here.
#
# System instance: /etc/phern/<user>.env    User service: ~/.config/phern/daemon.env

# Appended to `phern daemon --resume-owed`, split on whitespace. The profile new
# sessions start on, and the probe port an orchestrator polls (loopback unless
# something outside the host needs it).
PHERN_DAEMON_OPTS=--profile work --probe-bind 127.0.0.1:8750

# Sessions, attachments, profile overlays and daemon.yaml. Default: ~/.ph
#PH_HOME=/srv/phern/alice

# A credential a profile's route names reaches the daemon only this way, and is
# never written down by it. A root whose key is missing is held, by name, until a
# restart with the key or `credentials/store` supplies it.
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
