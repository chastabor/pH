  "cards": [
    {
      "dot": "cyan",
      "title": "Discovery at mount",
      "items": [
        "A manual is a UTCP call template, from config or ctx.utcp.add",
        "A manual that fails discovery is skipped, with a warning",
        "Only the cli protocol is allowed by default"
      ]
    },
    {
      "dot": "rose",
      "title": "A call is one command",
      "items": [
        "PhCliProtocol starts the script through ctx.shell.run_argv",
        "It runs in the calling agent's workspace and sandbox",
        "require_ran fails a cli call that skipped run_argv"
      ]
    },
    {
      "dot": "emerald",
      "title": "state, writable, traits",
      "items": [
        "state: $PH_TOOL_STATE in the calling agent's scratch",
        "writable: shared paths; one overlapping the workspace is refused",
        "tools: concurrency_safe and effect_free, both off by default"
      ]
    }
  ]
