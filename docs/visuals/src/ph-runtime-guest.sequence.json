  "cards": [
    {
      "dot": "cyan",
      "title": "One channel, two tasks",
      "items": [
        "A frame is one line of JSON on fd 3",
        "Runner.serve reads frames; the cell runs in its own task",
        "So a cell awaiting a reply never blocks the reader"
      ]
    },
    {
      "dot": "amber",
      "title": "Capped output",
      "items": [
        "print leaves as capped log frames",
        "Past maxLogBytes a write is counted and not sent",
        "done carries truncated and the dropped byte total"
      ]
    },
    {
      "dot": "rose",
      "title": "No harness inside",
      "items": [
        "It imports neither ph-core nor ph-rlm",
        "_characters.py and _json.py are copies of ph-core's code",
        "test_protocol_mirror.py fails when a copy or a frame drifts"
      ]
    }
  ]
