    "column_fit": "spread",
    "views": [
      {
        "id": "boot",
        "label": "Boot",
        "focus": [
          "kernel",
          "reader"
        ],
        "note": "The host owns every default: boot carries each limit, and a protocol mismatch is refused before boot-ack."
      },
      {
        "id": "binding-call",
        "label": "A binding call",
        "focus": [
          "cell",
          "kernel",
          "codemode",
          "reader"
        ],
        "note": "await tools.read(...) is one call frame out and one reply frame back, through ph-core's whole tool pipeline."
      },
      {
        "id": "settle",
        "label": "Output and done",
        "focus": [
          "cell",
          "kernel",
          "codemode"
        ],
        "note": "log frames stream capped output; snapshot frames come before done, so done is the last frame of a run."
      }
    ]
  },
