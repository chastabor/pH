  "cards": [
    {
      "dot": "cyan",
      "title": "Two processes",
      "items": [
        "A session's rows add the manual with ctx.utcp.add",
        "The tools, turbovec and the model run in ph-text-index",
        "ph-utcp starts that command under the agent's sandbox"
      ]
    },
    {
      "dot": "emerald",
      "title": "A passage fits its embedder",
      "items": [
        "Cuts land between paragraphs and keep 1-based line spans",
        "Packed by max_chars and by the embedder's token limit",
        "A question past the limit is searched by its head"
      ]
    },
    {
      "dot": "violet",
      "title": "The index",
      "items": [
        "index.tvim holds vectors; chunks.json holds the passages",
        "A digest per document skips unchanged text",
        "In a session it sits in the calling agent's scratch"
      ]
    }
  ]
