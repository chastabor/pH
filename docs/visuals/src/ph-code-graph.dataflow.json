  "cards": [
    {
      "dot": "cyan",
      "title": "Two processes",
      "items": [
        "The code-graph row adds the manual with ctx.utcp.add",
        "tree-sitter and sqlite3 run in the ph-code-graph command",
        "graph.db sits in the calling agent's scratch"
      ]
    },
    {
      "dot": "emerald",
      "title": "Two passes per file",
      "items": [
        "process() gives definitions, imports and docstrings",
        "The tags query gives @reference.call, the call edge",
        "Line numbers are normalized to 1-based on the way out"
      ]
    },
    {
      "dot": "violet",
      "title": "Name-based, and it says so",
      "items": [
        "callers and callees join refs on the name used",
        "An ambiguous result carries its definitions count",
        "A file is re-extracted only when its sha256 changes"
      ]
    }
  ]
