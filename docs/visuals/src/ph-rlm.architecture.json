  "cards": [
    {
      "dot": "emerald",
      "title": "One cell, many governed calls",
      "items": [
        "The model sees one callable, python",
        "Each binding call is a call frame back into the tool pipeline",
        "Forty calls log forty tool/code-dispatch records"
      ]
    },
    {
      "dot": "cyan",
      "title": "State lives in the log",
      "items": [
        "rlm-kernel-snapshot records one kernel/snapshot per changed variable",
        "Harness state is a fold over harness/refined events",
        "A dead kernel is replaced and the next run starts with a reset notice"
      ]
    },
    {
      "dot": "violet",
      "title": "Delegation does not block",
      "items": [
        "rlm.run returns an admission handle, not an answer",
        "A child's records are in the child's own log",
        "A denial ends the whole run; a failure is the program's to handle"
      ]
    }
  ]
