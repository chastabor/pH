  "cards": [
    {
      "dot": "cyan",
      "title": "Rows, not loop parameters",
      "items": [
        "Each row listens on a waterfall ph-core already fires",
        "The stabilize bundle is optional in every profile",
        "tool-todo and skill-steps ship disabled"
      ]
    },
    {
      "dot": "emerald",
      "title": "Relocated, not lost",
      "items": [
        "input-offload and compaction are surface replaces",
        "The log keeps the original; transcript() shows it",
        "A spilled tool result is a file the model can read"
      ]
    },
    {
      "dot": "rose",
      "title": "Asked, never relied on",
      "items": [
        "skill-steps holds its nudge when the turn waits on a person",
        "A decision route that fails leaves the usual nudge",
        "permissions-fs bounds ctx.fs calls, not a subprocess"
      ]
    }
  ]
