{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "self-steering: how a skill runs",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [
      1080,
      640
    ],
    "views": [
      {
        "id": "reading",
        "label": "Reading",
        "focus": [
          "person",
          "loop",
          "model",
          "skill",
          "steps",
          "todo"
        ],
        "note": "The skill tool returns the body and emits skills/read; skill-steps appends the steps to the todo list."
      },
      {
        "id": "working",
        "label": "Working",
        "focus": [
          "model",
          "todo"
        ],
        "note": "The model marks steps done with write_todos. A write that drops or reorders a seeded step is refused."
      },
      {
        "id": "asking",
        "label": "Asking",
        "focus": [
          "loop",
          "steps",
          "todo",
          "decider"
        ],
        "note": "At turn end the row folds the log, then asks a decision model whether the assistant is waiting for the person."
      },
      {
        "id": "hold-or-nudge",
        "label": "Outcome",
        "focus": [
          "person",
          "loop",
          "model",
          "steps"
        ],
        "note": "Waiting: the turn ends and the person answers. Not waiting: a plugin user/message starts another step."
      }
    ],
    "legend": {
      "entries": {
        "dashed": {
          "label": "Bus event"
        },
        "security": {
          "label": "Nudge"
        }
      }
    }
  },
