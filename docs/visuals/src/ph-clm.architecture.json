  "cards": [
    {
      "dot": "cyan",
      "title": "One door for every edit",
      "items": [
        "The tools and the context file both land through ctx.clm",
        "An edit is one surface replace plus a clm/revised record",
        "Both commit in one Session.batch()"
      ]
    },
    {
      "dot": "emerald",
      "title": "Sections",
      "items": [
        "A section is the run between two balanced cuts",
        "Its id is the seq of its first event, which never moves",
        "The step in flight is protected from edits"
      ]
    },
    {
      "dot": "violet",
      "title": "The log keeps the originals",
      "items": [
        "context_recall and context_diff read them back",
        "context_restore undoes a section's latest edit, one level",
        "A file change no tool call made is declined, then rewritten"
      ]
    }
  ]
