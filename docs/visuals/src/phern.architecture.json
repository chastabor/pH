  "cards": [
    {
      "dot": "cyan",
      "title": "The daemon owns the work",
      "items": [
        "A root is a mounted profile, a session, an agent and a queue",
        "Attaching subscribes to session.event; detaching stops nothing",
        "The TUI starts an ephemeral daemon when the socket is absent"
      ]
    },
    {
      "dot": "emerald",
      "title": "One way to mount",
      "items": [
        "The daemon and the one-shot modes all mount through ph_app.runtime",
        "A profile is offered only if every layer it names resolves",
        "ph_app never imports ph_rlm or ph_stabilize; bundles arrive by entry point"
      ]
    },
    {
      "dot": "orange",
      "title": "Adapters are rows",
      "items": [
        "llm-anthropic, llm-google and llm-openai-compatible register on ctx.llm",
        "decide posts /systemone beside /chat/completions for a decision model",
        "An apiKeyEnv is a name, resolved only when the request is sent"
      ]
    }
  ]
