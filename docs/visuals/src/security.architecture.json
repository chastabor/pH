  "cards": [
    {
      "dot": "emerald",
      "title": "Layers, outside in",
      "items": [
        "The OS sandbox bounds writes and the network at the kernel",
        "The workspace tier decides which tree an agent works in",
        "Gates and path rules see only calls that go through a seam"
      ]
    },
    {
      "dot": "cyan",
      "title": "What filters down",
      "items": [
        "A child holds a subset of its parent's tools and skills",
        "It runs on its parent's mount, so the same rows gate it",
        "A spawn narrows by restriction and can never widen"
      ]
    },
    {
      "dot": "violet",
      "title": "Stated limits",
      "items": [
        "Reads stay open inside the OS sandbox",
        "No backend means commands run unconfined",
        "A posture chosen for the root is not copied to a child"
      ]
    }
  ]
